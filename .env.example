APP_ENV=local
APP_PASSCODE=change-me
# Optional: when set, APP_PASSCODE signs in as operator and this passcode signs in as admin.
APP_ADMIN_PASSCODE=
APP_AUTH_COOKIE=citydata-passcode
# Generate with: openssl rand -hex 32
APP_SESSION_SECRET=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel sets VERCEL_ENV automatically: development, preview, or production.
# Use APP_ENV to make the app label explicit: local, preview, staging, or production.
